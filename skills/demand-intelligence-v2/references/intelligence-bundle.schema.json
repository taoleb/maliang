{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.hermes/intelligence-v2/intelligence-bundle.schema.json",
  "title": "Hermes Intelligence Bundle v2",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "domain",
    "request",
    "facts",
    "inferences",
    "gaps",
    "provenance",
    "run_manifest"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "run_id": {"type": "string", "minLength": 1},
    "domain": {
      "enum": ["demand", "policy", "capital", "industry", "competitive", "cross-domain"]
    },
    "request": {
      "type": "object",
      "required": ["query", "subject", "function_ids", "write_authorized"]
    },
    "facts": {"type": "array"},
    "inferences": {"type": "array"},
    "gaps": {"type": "array"},
    "provenance": {"type": "array"},
    "run_manifest": {
      "type": "object",
      "required": [
        "started_at",
        "completed_at",
        "data_as_of",
        "used_tools",
        "unavailable_tools",
        "disabled_tools",
        "failed_calls",
        "validation_status"
      ]
    }
  }
}
